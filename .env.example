# Create an app at https://dashboard.privy.io (enable email + passkey login,
# add localhost as an allowed domain for dev) and paste the App ID here.
NEXT_PUBLIC_PRIVY_APP_ID=

# Alchemy key for Base mainnet, used to read USDC transfer history.
# Without it the activity list falls back to placeholder entries.
# Every NEXT_PUBLIC_ value ships to the browser, so restrict the key to your
# domains in the Alchemy dashboard.
NEXT_PUBLIC_ALCHEMY_API_KEY=

# Optional. CoinGecko's public tier works without a key; a demo key raises the
# rate limit. Exchange rates come from USDC's price in each fiat currency.
NEXT_PUBLIC_COINGECKO_API_KEY=

# Optional. Defaults to Base's public RPC, which is fine for reads but gets
# rate-limited under real traffic.
NEXT_PUBLIC_BASE_RPC_URL=

# p2p.me's diamond contract on Base, (send orders on p2p)
NEXT_PUBLIC_DIAMOND_ADDRESS=

# p2p.me's subgraph. The orders client requires it, though today's send flow
# only reads orders directly from the diamond contract, not through this.
NEXT_PUBLIC_P2P_SUBGRAPH_URL=

# Feature flags. Off unless set to exactly "true".
#
# Cash pickup and cash payout to a contact. Off because no Ruma points exist;
# turning it on offers the user somewhere they cannot actually go.
NEXT_PUBLIC_FEATURE_CASH_POINTS=
