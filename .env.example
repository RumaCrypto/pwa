# Create an app at https://dashboard.privy.io (enable email + passkey login,
# add localhost as an allowed domain for dev) and paste the App ID here.
NEXT_PUBLIC_PRIVY_APP_ID=

# Alchemy key for Base mainnet, used to read USDC transfer history.
# Without it the activity list falls back to placeholder entries.
# Every NEXT_PUBLIC_ value ships to the browser, so restrict the key to your
# domains in the Alchemy dashboard.
NEXT_PUBLIC_ALCHEMY_API_KEY=

# Optional. CoinGecko's public tier works without a key; a demo key raises the
# rate limit. Exchange rates come from USDC's price in each fiat currency.
NEXT_PUBLIC_COINGECKO_API_KEY=

# Optional. Defaults to Base's public RPC, which is fine for reads but gets
# rate-limited under real traffic.
NEXT_PUBLIC_BASE_RPC_URL=

# p2p.me's diamond contract on Base (send orders on p2p).
NEXT_PUBLIC_DIAMOND_ADDRESS=

# p2p.me's subgraph. The orders client requires it, though today's send flow
# only reads orders directly from the diamond contract, not through this.
NEXT_PUBLIC_P2P_SUBGRAPH_URL=

# The @p2pdotme/sdk module surface, not wired up yet — see lib/p2p/config.ts.
# The SDK reads no env vars itself; these are collected there and passed to its
# factories. It still reads the diamond address under its own name, so set this
# to the same value as NEXT_PUBLIC_DIAMOND_ADDRESS above:
NEXT_PUBLIC_P2P_DIAMOND_ADDRESS=
# Optional. p2p.me's Reputation Manager on Base. Verifications credit
# Reputation Points here, and those are what make up a user's BUY limit (a
# wallet with none can sell but cannot buy). Also read by /limits:
NEXT_PUBLIC_P2P_REPUTATION_MANAGER_ADDRESS=
# Optional. p2p.me's liveness proxy (e.g. https://liveness-proxy.p2p.cool),
# needed together with the address above for the face check on /limits. The
# proxy only redirects back to origins on its tenant allowlist.
NEXT_PUBLIC_P2P_LIVENESS_PROXY_URL=
# Optional. Both are needed together to enable the fraud engine:
NEXT_PUBLIC_P2P_FRAUD_API_URL=
NEXT_PUBLIC_P2P_FRAUD_ENCRYPTION_KEY=

# Aurora Intents API key, from https://studio.aurora.dev. Read only by the
# /api/intents/* routes, so it never ships to the browser. Fees for this key
# are set in https://portal.intents.aurora.dev.
AURORA_INTENTS_API_KEY=

# Feature flags. Off unless set to exactly "true".
#
# Cash pickup and cash payout to a contact. Off because no Ruma points exist;
# turning it on offers the user somewhere they cannot actually go.
NEXT_PUBLIC_FEATURE_CASH_POINTS=

# The card. Off because no issuer is connected; with it off the home carousel
# shows a "coming soon" card face and /card says the flow is not ready.
NEXT_PUBLIC_FEATURE_CARD=

# Deposits from other networks (Tron, Bitcoin, Ethereum, ...) converted to USDC
# on Base by Aurora Intents. Needs AURORA_INTENTS_API_KEY above.
NEXT_PUBLIC_FEATURE_MULTICHAIN_DEPOSITS=
# Where a failed conversion is refunded. "origin" (default) asks the user for
# their own address on the network they send from; "intents" refunds into
# their NEAR Intents account instead (confirm with Aurora before using it).
NEXT_PUBLIC_INTENTS_REFUND_MODE=

# Ruma's flat fee on withdrawals to other networks, sent as a second USDC
# transfer to the treasury. Off unless "true"; needs a valid treasury address
# and an amount between 0 and 5 USD (default 0.10).
NEXT_PUBLIC_WITHDRAW_FEE_ENABLED=
NEXT_PUBLIC_WITHDRAW_FEE_USD=
NEXT_PUBLIC_RUMA_TREASURY_ADDRESS=
# Optional. NEAR RPC used to check that a named NEAR account exists before
# withdrawing to it. Defaults to https://free.rpc.fastnear.com.
NEAR_RPC_URL=

# Server-only. Verifies the Privy session on /api/intents/*. Privy dashboard → App settings.
PRIVY_APP_SECRET=
# Optional. "false" lets /api/intents/* through without a session (local work only).
INTENTS_AUTH_REQUIRED=
# Optional. Calls per user to /api/intents/*, as <requests>/<seconds>. Default 30/60, counted per route; "off" disables.
INTENTS_RATE_LIMIT=
# Optional. With both set, the limit is counted in Redis across Vercel instances
# instead of in memory per instance. Vercel → Storage → Upstash Redis sets them;
# a Vercel KV store sets KV_REST_API_URL / KV_REST_API_TOKEN instead, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
